# ----------------------------
# Local-only project files
# ----------------------------
backend-fastapi/Test Data/DBG Logs/
frontend-react/src/APPsafehouse.txt

# Motor profiles calibrated on THIS bench [v11] — operator data, not source.
# The three built-in profiles live in frontend-react/src/motorProfiles.ts;
# this file is whatever the Motor Config tab measured on this machine.
backend-fastapi/motor_profiles.json
backend-fastapi/motor_profiles.json.tmp
backend-fastapi/motor_profiles.test.json

# Migrated pre-v13 data stores — kept on disk for recovery, never in the repo
*.json.migrated

# Documentations
/docs

# Claude config
.claude/
# ----------------------------
# Stage 8 — deployment [v14]
# ----------------------------
# Rust build output. Large (GBs) and fully reproducible from source.
src-tauri/target/
# Generated by tauri-build on every build; not source.
src-tauri/gen/

# PyInstaller output. `build/` and `dist/` above already cover these; named
# explicitly because they are what the installer is assembled from and someone
# will eventually wonder where they went.
backend-fastapi/build/
backend-fastapi/dist/

# SIGNING MATERIAL — never commit. The updater private key lives OUTSIDE the
# repo (~/.nwa-updater-keys/) and in GitHub Actions secrets; a leaked key lets
# someone else sign an update this app would install without complaint.
*.key
*.pfx
*.p12
*.snk
.tauri-updater.key*

# The code-signing certificate's public half is safe to share but is generated
# per machine, so it is not source either.
certs/
