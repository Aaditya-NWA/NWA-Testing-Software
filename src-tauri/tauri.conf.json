{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NWA Testing Software",
  "version": "1.0.0",
  "identifier": "com.nwa.testing-software",
  "build": {
    "frontendDist": "../frontend-react/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix frontend-react run dev",
    "beforeBuildCommand": "npm --prefix frontend-react run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NWA Testing Software",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend-fastapi/dist/nwa-backend": "backend"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Aaditya-NWA/NWA-Testing-Software/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQ0NGRjM1MDRFREU1QzAKUldUQTVlMEVOZi9NamxLQVNOUjJMQnpRMklQOHRNdEVrMHQrWkFpeW9Qb0NtaGhEYUtzRFFYcFgK"
    }
  }
}
