{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // [FIX] `npm run build` is `tsc && vite build`, and without this tsc
    // EMITS a .js next to every .ts/.tsx in src/. Vite does the actual
    // bundling, so tsc's only job here is typechecking. The stray files
    // were previously invisible because the build failed on a missing
    // @types/lodash before it ever got as far as emitting; fixing that
    // made them appear. Left alone they clutter the tree and can shadow
    // the real sources for tooling that resolves .js first.
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
